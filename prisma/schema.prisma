// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

//////////////////////
// 🔐 AUTH SYSTEM (NKS)
//////////////////////

model User {
  id                  Int                  @id @default(autoincrement())
  email               String               @unique
  name                String
  password            String
  sessions            Session[]
  passwordResetTokens PasswordResetToken[]

  // ecommerce relation
  employee      Employee?
  customer      Customer?
  pendingAdmins PendingAdmin[]
}

model PendingAdmin {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  isPending Boolean @default(true)
  user      User?   @relation(fields: [userId], references: [id])
  userId    Int?
}

model PendingEmployee {
  id        Int     @id @default(autoincrement())
  email     String  @unique
  isPending Boolean
}

model Session {
  id        String   @id @default(uuid())
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
  revoked   Boolean  @default(false)
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    Int
  tokenHash String
  createdAt DateTime  @default(now())
  expiresAt DateTime
  usedAt    DateTime?

  user User @relation(fields: [userId], references: [id])
}

//////////////////////
// 🧾 ECOMMERCE CORE
//////////////////////

model Customer {
  customerId Int   @id @default(autoincrement())
  userId     Int?  @unique
  user       User? @relation(fields: [userId], references: [id])

  name             String
  phone            String
  address          String
  email            String?
  registrationDate DateTime @default(now())
  clientId         String?
  ordersCount      Int      @default(0)

  orders Order[]
}

model ProductCategory {
  categoryId  Int       @id @default(autoincrement())
  name        String
  description String?
  products    Product[]
}

model Product {
  productId   Int     @id @default(autoincrement())
  name        String
  description String?
  price       Int

  categoryId Int
  category   ProductCategory @relation(fields: [categoryId], references: [categoryId])

  inventory  Inventory?
  orderItems OrderItem[]
}

model Inventory {
  inventoryId Int     @id @default(autoincrement())
  productId   Int     @unique
  product     Product @relation(fields: [productId], references: [productId])

  quantityAvailable Int
  lastUpdated       DateTime @updatedAt
}

model OrderStatus {
  orderStatusId Int     @id @default(1)
  name          String
  description   String?

  orders Order[]
}

model Order {
  orderId Int @id @default(autoincrement())

  customerId Int
  customer   Customer @relation(fields: [customerId], references: [customerId])

  orderDate DateTime @default(now())

  orderStatusId Int
  status        OrderStatus @relation(fields: [orderStatusId], references: [orderStatusId])

  employeeId Int?
  employee   Employee? @relation(fields: [employeeId], references: [employeeId])

  notes String?

  orderItems OrderItem[]
  payments   OrderPayment[]
}

model OrderItem {
  orderItemId Int @id @default(autoincrement())

  orderId Int
  order   Order @relation(fields: [orderId], references: [orderId])

  productId Int
  product   Product @relation(fields: [productId], references: [productId])

  quantity Int
  price    Int
}

model OrderPayment {
  paymentId Int   @id @default(autoincrement())
  orderId   Int
  order     Order @relation(fields: [orderId], references: [orderId])

  amount      Int
  paymentDate DateTime @default(now())
  notes       String?
}

//////////////////////
// 👨‍💼 EMPLOYEE SYSTEM
//////////////////////

model Employee {
  employeeId Int @id @default(autoincrement())

  userId Int  @unique
  user   User @relation(fields: [userId], references: [id], onDelete: Cascade)

  name        String
  phoneNumber String?
  isActive    Boolean @default(true)

  paymentTypeId Int                 @default(1)
  paymentType   EmployeePaymentType @relation(fields: [paymentTypeId], references: [paymentTypeId])

  roles                    EmployeeRoleAssignment[]
  ordersHandled            Order[]
  payments                 EmployeePayment[]
  employeePaymentContracts EmployeePaymentContract[]
}

model EmployeeRole {
  roleId      Int     @id @default(autoincrement())
  name        String
  description String?

  employees EmployeeRoleAssignment[]
}

model EmployeeRoleAssignment {
  employeeId Int
  roleId     Int
  assignedAt DateTime @default(now())

  employee Employee     @relation(fields: [employeeId], references: [employeeId])
  role     EmployeeRole @relation(fields: [roleId], references: [roleId])

  @@id([employeeId, roleId])
}

model EmployeePaymentType {
  paymentTypeId Int     @id @default(autoincrement())
  name          String // SALARY | PER_ORDER
  description   String?

  contracts EmployeePaymentContract[]
  employees Employee[]
}

model EmployeePaymentContract {
  contractId Int @id @default(autoincrement())

  employeeId    Int
  paymentTypeId Int

  // SALARY mode
  salaryAmount Int?

  // PER ORDER mode
  perOrderRate Int?

  effectiveFrom DateTime
  effectiveTo   DateTime?

  isActive Boolean @default(true)

  employee         Employee            @relation(fields: [employeeId], references: [employeeId])
  type             EmployeePaymentType @relation(fields: [paymentTypeId], references: [paymentTypeId])
  employeePayments EmployeePayment[]

  @@index([employeeId, isActive])
}

model EmployeePayment {
  employeePaymentId Int @id @default(autoincrement())
  employeeId        Int

  employee Employee @relation(fields: [employeeId], references: [employeeId])

  amount              Int
  paymentPeriodLabel String?
  paymentPeriodStart DateTime?
  paymentPeriodEnd   DateTime?
  paymentDate        DateTime @default(now())
  notes              String?

  // optional snapshot for audit
  contractId Int?
  contract   EmployeePaymentContract? @relation(fields: [contractId], references: [contractId])
}

model PayrollRun {
  payrollRunId   Int       @id @default(autoincrement())
  startDate     DateTime
  endDate       DateTime
  status        String    @default("DRAFT")
  totalAmount   Int?
  createdAt     DateTime  @default(now())
  confirmedAt   DateTime?

  items         PayrollRunItem[]
}

model PayrollRunItem {
  payrollRunItemId Int        @id @default(autoincrement())
  payrollRunId     Int
  employeeId       Int
  contractId       Int?
  amount           Int
  calculationStatus String   @default("PENDING")  // PENDING | INCLUDED | EXCLUDED
  paymentStatus    String   @default("UNPAID")   // UNPAID | CONFIRMED | PAID
  warning          String?
  paidAt           DateTime?
  confirmedAt      DateTime?

  payrollRun     PayrollRun @relation(fields: [payrollRunId], references: [payrollRunId])
}
